# OPENAI_API_KEY is no longer needed — to11 holds it as a connected provider.

# to11 auth (the SDK reads these from the environment)
TO11_API_KEY=
TO11_PROJECT_ID=

# The connected provider's slug (e.g. openai-01sj) — required, since the app sends
# no provider key. Routes via the gateway's "<slug>::<model>" convention.
TO11_PROVIDER=

TO11_ENV=prod

# Optional — override only to point at a local/self-hosted to11. Two different
# hosts, each the host only (no path); the SDK adds each path it needs.
# TO11_API_URL=https://api.to11.ai       # control plane — render() fetches the prompt
# TO11_GATEWAY_URL=https://gw.to11.ai    # data plane — the model call
