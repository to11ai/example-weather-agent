# OPENAI_API_KEY is no longer needed — to11 holds it as a connected provider.

# to11 gateway auth (sent as headers; no to11 SDK required)
TO11_API_KEY=
TO11_PROJECT_ID=

# The connected provider's slug (e.g. openai-01sj) — required, since the app sends
# no provider key. Routes via the gateway's "<slug>::<model>" convention.
TO11_PROVIDER=

TO11_GATEWAY_URL=https://gw.to11.ai/v1
TO11_ENV=prod
