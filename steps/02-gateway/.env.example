# Provider key — still set in step 02; the gateway forwards it upstream.
OPENAI_API_KEY=

# to11 auth (the SDK reads these from the environment)
TO11_API_KEY=
TO11_PROJECT_ID=
TO11_ENV=prod

# Optional — override only to point at a local/self-hosted to11. The gateway URL
# is the host only (no /v1); the SDK adds the path each provider client expects.
# TO11_GATEWAY_URL=https://gw.to11.ai
